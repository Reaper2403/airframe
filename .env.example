# Server-only configuration. Copy to .env.server; never place it under dist/.
# Read OPENAI_API_KEY from an existing local dotenv file, or set it in the process environment.
AIRFRAME_OPENAI_ENV_FILE=/absolute/path/to/project/.env.local
# Optional: otherwise use OPENAI_MODEL from that file, then gpt-6-astra.
# AIRFRAME_OPENAI_MODEL=gpt-6-astra
# Python needs reportlab installed; configure an absolute interpreter path if needed.
AIRFRAME_PYTHON=python3
